# PIA region for each tunnel (region id: make regions). vpn1 = primary, vpn2 = backup.
# Same region in both is fine: the tunnels start on different servers of that region.
VPN1_REGION=poland
VPN2_REGION=poland
# PIA OpenVPN UDP port (the GUI uses 853; also 8080/123/53)
PIA_PORT=853

# PIA SOCKS5 multi-hop proxy (username/password go in secrets/socks-auth.txt)
SOCKS_HOST=proxy-nl.privateinternetaccess.com
SOCKS_PORT=1080

# Where to publish the balancer: 127.0.0.1 = this machine only, 0.0.0.0 = whole LAN (no auth!)
BIND=127.0.0.1
LB_SOCKS_PORT=1081
LB_HTTP_PORT=8888
LB_STATS_PORT=8404
