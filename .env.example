# PIA region for each tunnel (region id: make regions). vpn1 = primary, vpn2 = backup.
# Same region in both is fine: the tunnels start on different servers of that region.
VPN1_REGION=poland
VPN2_REGION=poland
# PIA OpenVPN UDP port (the GUI uses 853; also 8080/123/53)
PIA_PORT=853

# PIA SOCKS5 multi-hop proxy (username/password go in secrets/socks-auth.txt).
# A hostname or a comma-separated list of IPs/hostnames: tunnel N uses the N-th address, so the
# tunnels go through different proxies (proxy-nl resolves to a pool of ~10 of them).
SOCKS_HOST=proxy-nl.privateinternetaccess.com
SOCKS_PORT=1080

# Planned reconnect period per tunnel, seconds. PIA's proxy drops sessions after ~2 h; each tunnel
# reconnects earlier on its own schedule, half a period apart, while the other one carries the traffic.
# ROTATE_PERIOD=6000

# Where to publish the balancer: 127.0.0.1 = this machine only, 0.0.0.0 = whole LAN (no auth!)
BIND=127.0.0.1
LB_SOCKS_PORT=1081
LB_HTTP_PORT=8888
LB_STATS_PORT=8404
